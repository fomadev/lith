#include <windows.h>

// ============================================================================
//  ICÔNE DE L'APPLICATION
//  L'identifiant 1 (ou MAINICON) indique à Windows que c'est l'icône principale
// ============================================================================
1 ICON "app_icon.ico"

// ============================================================================
//  INFORMATIONS DE VERSION ET CONFIGURATION
// ============================================================================
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0" // Code langue : Anglais (États-Unis)
        BEGIN
            VALUE "CompanyName",      "FomaDev (Fordima Inc.)"
            VALUE "FileDescription",  "LITH - Light HTTP Server"
            VALUE "FileVersion",      "1.0.0"
            VALUE "InternalName",     "lith"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Fordima Inc. Licensed under the Fordima Public License (FPL) v1.0."
            VALUE "OriginalFilename", "lith.exe"
            VALUE "ProductName",      "LITH Engine"
            VALUE "ProductVersion",   "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END